# ==============================================================================
# Variables Públicas de Frontend (Vite — expuestas al cliente; NUNCA incluir secretos)
# ==============================================================================

# Supabase Configuration (pública)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
VITE_SUPABASE_ANON_KEY=your-anon-key

# Application Environment (production | staging | preview | development)
VITE_APP_ENV=development

# Canonical Public Origin for Generated Links & Social Metadata (no trailing slash)
# Production: https://puntoencuentro.com.ar
# Staging:    https://staging.puntoencuentro.com.ar
# Local:      http://localhost:5173
VITE_APP_URL=

# Exigir VITE_APP_URL explícita en builds publicados (activar en corte de nuevo dominio)
# VITE_REQUIRE_EXPLICIT_APP_URL=false

# Brand & Public Contact Metadata (opcionales; por defecto conservan PuntoEncuentro)
# VITE_APP_BRAND_NAME=PuntoEncuentro
# VITE_APP_SHORT_NAME=PuntoEncuentro
# VITE_PUBLIC_SUPPORT_EMAIL=soporte@puntoencuentro.com.ar
# VITE_APP_TWITTER_SITE=@puntoencuentro

# Web Push Public Key (base64url; la clave secreta VAPID solo vive en Supabase Edge Functions)
# VITE_VAPID_PUBLIC_KEY=

# ==============================================================================
# Variables Exclusivas de Servidor / Serverless (Vercel Functions / Edge — NO expuestas en Vite)
# ==============================================================================

# Origen canónico autoritativo del servidor (opcional; si se omite usa VITE_APP_URL o canónico del ambiente)
# PUBLIC_APP_ORIGIN=https://puntoencuentro.com.ar
# PUBLIC_STAGING_ORIGIN=https://staging.puntoencuentro.com.ar

# Lista separada por comas de dominios propios históricos retirados (vacía hasta migrar a nuevo dominio)
# Ejemplo futuro (N->1 directo sin cadenas): LEGACY_APP_ORIGINS=https://puntoencuentro.com.ar
# LEGACY_APP_ORIGINS=

# Compuerta de redirección de dominios históricos (mantener false hasta completar rescate de usuarios)
# ENABLE_LEGACY_DOMAIN_REDIRECT=false
