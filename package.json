{
  "name": "temp-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "test:unit:access-gate": "node scripts/run-tests.mjs ./scripts/test-access-gate-pre-launch.ts",
    "test:unit:domain-readiness": "node scripts/run-tests.mjs ./scripts/test-domain-migration-readiness.ts",
    "test:unit:domain-bridge-ui": "node scripts/run-tests.mjs ./scripts/test-domain-bridge-frontend.ts",
    "test:sql:domain-bridge": "node scripts/run-tests.mjs ./scripts/test-domain-identity-bridge.ts",
    "test:sql:security-h1-h10": "node scripts/run-tests.mjs ./scripts/test-pre-staging-verification-h1-h10.ts",
    "test:sql:schema-parity": "node scripts/run-tests.mjs ./scripts/test-schema-parity-guard.ts",
    "qa:preflight:staging": "npx --workspaces=false tsx scripts/staging-preflight-domain-bridge.ts",
    "qa:audit:staging": "npx --workspaces=false tsx scripts/audit-staging-security-state.ts",
    "qa:browser:local": "npx --workspaces=false tsx scripts/playwright-qa-runner.ts",
